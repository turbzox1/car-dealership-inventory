DATABASE_URL="postgresql://dealership:dealership@localhost:5433/dealership"

# Required, at least 32 characters, and not a placeholder. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

PORT=4000
# Interface to listen on. Defaults to 127.0.0.1, or 0.0.0.0 when NODE_ENV=production.
# HOST=127.0.0.1

# Used by `npm run seed`. Password: at least 12 characters, not a placeholder.
ADMIN_EMAIL="admin@dealership.com"
ADMIN_PASSWORD=""

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS="http://localhost:5173"

# Number of reverse proxies in front of the API (1 on Render/Heroku); leave empty locally
TRUST_PROXY=
