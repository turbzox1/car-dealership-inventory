generator client {
  provider = "prisma-client-js"
}

// Connection URL lives in prisma.config.ts (Prisma 7+)
datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Category {
  SEDAN
  SUV
  TRUCK
  HATCHBACK
  COUPE
  CONVERTIBLE
  VAN
  EV
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(USER)
  createdAt    DateTime   @default(now())
  purchases    Purchase[]
}

model Vehicle {
  id         String     @id @default(uuid())
  make       String
  model      String
  category   Category
  price      Decimal    @db.Decimal(12, 2)
  quantity   Int        @default(0) // CHECK (quantity >= 0) is added in migration SQL
  // Soft delete: archived vehicles are hidden but purchase history stays intact
  isArchived Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  purchases  Purchase[]

  @@index([make])
  @@index([model])
  @@index([category])
}

model Purchase {
  id          String   @id @default(uuid())
  userId      String
  vehicleId   String
  // Snapshot of the vehicle at the time of sale
  make        String
  model       String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  purchasedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])

  @@index([userId])
}
